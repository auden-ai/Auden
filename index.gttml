<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AUDEN AI - JARVIS जैसे</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: 'Segoe UI', sans-serif; 
            background: linear-gradient(135deg, #0c0c0c 0%, #1a1a2e 50%, #16213e 100%);
            height: 100vh; overflow: hidden;
            color: white;
        }

        /* Big Bang Animation - 1 Second */
        .bigbang { 
            position: fixed; top: 0; left: 0; width: 100%; height: 100%; 
            z-index: 1000; pointer-events: none;
        }
        .particles {
            position: absolute; width: 4px; height: 4px; background: #00ffff;
            border-radius: 50%; box-shadow: 0 0 10px #00ffff;
        }
        .sphere { 
            position: absolute; top: 50%; left: 50%; width: 20px; height: 20px;
            background: radial-gradient(circle, #00ffff, transparent);
            border-radius: 50%; transform: translate(-50%, -50%);
            animation: bigbang 1s ease-out forwards;
        }
        
        @keyframes bigbang {
            0% { transform: translate(-50%, -50%) scale(0.1); opacity: 1; }
            50% { transform: translate(-50%, -50%) scale(50) rotate(180deg); opacity: 0.8; }
            100% { transform: translate(-50%, -50%) scale(100) rotate(720deg); opacity: 0; }
        }
        .flash {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: white; opacity: 0;
            animation: flash 0.3s 0.7s forwards;
            z-index: 1001;
        }
        @keyframes flash {
            0% { opacity: 0; }
            50% { opacity: 1; }
            100% { opacity: 0; }
        }

        /* Main Interface */
        .main-interface { display: none; height: 100vh; }
        .header {
            background: rgba(0,255,255,0.1); backdrop-filter: blur(10px);
            padding: 1rem; text-align: center; border-bottom: 1px solid #00ffff;
        }
        .auden-title {
            font-size: 2rem; background: linear-gradient(45deg, #00ffff, #ff00ff);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            animation: glow 2s infinite alternate;
        }
        @keyframes glow { 0% { text-shadow: 0 0 10px #00ffff; } 100% { text-shadow: 0 0 30px #ff00ff; } }

        .chat-container {
            height: calc(100vh - 120px); overflow-y: auto; padding: 1rem;
            display: flex; flex-direction: column; gap: 1rem;
        }
        .message {
            max-width: 80%; padding: 1rem; border-radius: 20px;
            animation: slideIn 0.3s ease;
        }
        .user { background: linear-gradient(135deg, #00ffff, #0099cc); align-self: flex-end; }
        .auden { background: rgba(255,255,255,0.1); backdrop-filter: blur(10px); }
        @keyframes slideIn { from { opacity: 0; transform: translateY(20px); } }

        .input-area {
            position: fixed; bottom: 0; left: 0; right: 0;
            background: rgba(0,0,0,0.9); padding: 1rem; backdrop-filter: blur(20px);
        }
        .input-group {
            display: flex; gap: 1rem; align-items: center;
        }
        #messageInput {
            flex: 1; padding: 1rem 1.5rem; border: 2px solid #00ffff;
            border-radius: 50px; background: rgba(255,255,255,0.1);
            color: white; font-size: 1rem; outline: none;
        }
        #messageInput:focus { box-shadow: 0 0 20px #00ffff; }
        #sendBtn {
            padding: 1rem 2rem; background: linear-gradient(45deg, #00ffff, #ff00ff);
            border: none; border-radius: 50px; color: black; font-weight: bold;
            cursor: pointer; transition: all 0.3s;
        }
        #sendBtn:hover { transform: scale(1.05); box-shadow: 0 10px 30px rgba(0,255,255,0.5); }

        .suggestions { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.5rem; }
        .suggestion {
            padding: 0.5rem 1rem; background: rgba(0,255,255,0.2);
            border: 1px solid #00ffff; border-radius: 20px; cursor: pointer;
            font-size: 0.9rem; transition: all 0.3s;
        }
        .suggestion:hover { background: #00ffff; color: black; }
    </style>
</head>
<body>
    <!-- Big Bang Animation -->
    <div class="bigbang" id="bigbang">
        <div class="sphere"></div>
        <div class="flash" id="flash"></div>
    </div>

    <!-- Main Interface -->
    <div class="main-interface" id="mainInterface">
        <div class="header">
            <h1 class="auden-title">AUDEN AI</h1>
            <p>आपका व्यक्तिगत JARVIS 🚀</p>
        </div>
        
        <div class="chat-container" id="chatContainer">
            <div class="message auden">
                <strong>AUDEN:</strong> नमस्ते बॉस! मैं AUDEN हूँ - आपका JARVIS। Screenshot, volume, camera, flashlight सब control कर सकता हूँ। क्या आज्ञा है? 🎯
            </div>
        </div>

        <div class="input-area">
            <div class="input-group">
                <input type="text" id="messageInput" placeholder="आपकी आज्ञा बोलिए... (screenshot, volume up, camera etc)" autocomplete="off">
                <button id="sendBtn">SEND 🚀</button>
            </div>
            <div class="suggestions" id="suggestions"></div>
        </div>
    </div>

    <script>
        // Big Bang Animation - Exactly 1 Second
        setTimeout(() => {
            document.getElementById('bigbang').style.display = 'none';
            document.getElementById('mainInterface').style.display = 'block';
        }, 1000);

        // Particles Effect
        function createParticles() {
            for(let i = 0; i < 50; i++) {
                const particle = document.createElement('div');
                particle.className = 'particles';
                particle.style.left = '50%';
                particle.style.top = '50%';
                particle.style.animationDelay = `${Math.random() * 0.5}s`;
                document.getElementById('bigbang').appendChild(particle);
            }
        }
        createParticles();

        // Chat Logic
        const chatContainer = document.getElementById('chatContainer');
        const messageInput = document.getElementById('messageInput');
        const sendBtn = document.getElementById('sendBtn');
        const suggestionsDiv = document.getElementById('suggestions');
        let chatHistory = [];

        async function sendMessage() {
            const message = messageInput.value.trim();
            if (!message) return;

            // User Message
            addMessage(message, 'user');
            messageInput.value = '';

            // Send to Backend
            const response = await fetch('/chat', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({message, history: chatHistory})
            });
            
            const data = await response.json();
            addMessage(data.reply, 'auden');
            
            // Show Suggestions
            if (data.suggestions) {
                showSuggestions(data.suggestions);
            }
            
            chatHistory.push({role: 'user', content: message});
            chatHistory.push({role: 'assistant', content: data.reply});
        }

        function addMessage(text, sender) {
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${sender}`;
            messageDiv.innerHTML = sender === 'user' 
                ? `<strong>आप:</strong> ${text}`
                : `<strong>AUDEN:</strong> ${text}`;
            chatContainer.appendChild(messageDiv);
            chatContainer.scrollTop = chatContainer.scrollHeight;
        }

        function showSuggestions(suggestions) {
            suggestionsDiv.innerHTML = '';
            suggestions.forEach(suggestion => {
                const btn = document.createElement('div');
                btn.className = 'suggestion';
                btn.textContent = suggestion;
                btn.onclick = () => {
                    messageInput.value = suggestion;
                    sendMessage();
                };
                suggestionsDiv.appendChild(btn);
            });
        }

        // Event Listeners
        sendBtn.onclick = sendMessage;
        messageInput.onkeypress = (e) => e.key === 'Enter' && sendMessage();
    </script>
</body>
</html>
